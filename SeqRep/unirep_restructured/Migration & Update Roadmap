def call(self, inputs, states):
    # Unpack the state tuple
    c_prev, h_prev = states
    
    # Use deterministic matrix multiplications with fixed operation order
    with tf.name_scope('multiplicative_connection'):
        mx = tf.matmul(inputs, self.wmx, name="mx")
        mh = tf.matmul(h_prev, self.wmh, name="mh")
        m = mx * mh  # Element-wise multiplication
    
    with tf.name_scope('gates'):
        wx_result = tf.matmul(inputs, self.wx, name="wx_result")
        wh_result = tf.matmul(m, self.wh, name="wh_result")
        z = wx_result + wh_result + self.b
